{
	"name": "optigon",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Optigon — the many-faceted optimizer. A Rust core that packages interchangeable implementations per domain and learns which to run per workload, shipped as native addons to TypeScript (Node/Bun) and Python.",
	"workspaces": ["crates/optigon-node", "examples/*"],
	"scripts": {
		"build": "turbo run build",
		"test": "cargo test --workspace",
		"lint": "biome check .",
		"fmt": "biome format --write . && cargo fmt",
		"node:build": "cd crates/optigon-node && napi build --platform --release",
		"node:build:debug": "cd crates/optigon-node && napi build --platform",
		"node:demo": "cd examples/node-demo && bun run demo.ts",
		"py:build": "cd crates/optigon-python && maturin develop --release",
		"py:demo": "cd examples/py-demo && python3 demo.py"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9",
		"@napi-rs/cli": "^2.18.0",
		"bun-types": "latest",
		"turbo": "^2"
	},
	"packageManager": "bun@1.3.14"
}
